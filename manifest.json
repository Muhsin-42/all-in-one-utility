{
  "manifest_version": 3,
  "name": "Browser Kit",
  "version": "2.2.0",
  "description": "Handy browser tools: a cleaner YouTube, video speed and volume control, color picker, font inspector, CORS switch and site blocker.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules.json" }
    ]
  },
  "web_accessible_resources": [
    { "resources": ["blocked.html"], "matches": ["<all_urls>"] }
  ],
  "action": {
    "default_title": "Browser Kit",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "features.js",
        "speed.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "speed-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": [
        "settings.js",
        "dislikes.js"
      ],
      "css": [
        "hide.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
