{
  "manifest_version": 3,
  "name": "YT Quick Hide",
  "version": "2.0.0",
  "description": "One-click \"Not interested\" + \"Don't recommend channel\", plus switches to hide YouTube's feeds, Shorts, comments and other distractions.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "action": {
    "default_title": "YT Quick Hide",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": ["features.js", "settings.js"],
      "css": ["hide.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
